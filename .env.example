# Mosc-Tools — Ontime Show Flow Sync
# All variables are optional; sensible defaults are used when unset.

# Port the server listens on (GoDaddy sets this automatically)
#PORT=5000

# Host/interface to bind (default 0.0.0.0)
#HOST=0.0.0.0

# Path to the SQLite database file (default ./data.db)
#SHOWFLOW_DB=./data.db
